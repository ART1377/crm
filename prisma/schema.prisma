// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Lead {
  id             String     @id @default(cuid())
  
  businessName   String
  contactPerson  String?
  phoneNumber    String
  secondaryPhone String?
  industry       String
  source         String     @default("DIRECT")
  status         String     @default("NEW")
  notes          String?
  address        String?    // فیلد جدید برای آدرس
  website        String?    // فیلد جدید برای وبسایت
  rating         Float?     // فیلد جدید برای امتیاز
  category       String?    // فیلد جدید برای دسته‌بندی
  
  activities     Activity[]
  tasks          Task[]
  channels       String    @default("") // comma-separated: "WHATSAPP,SMS,CALL"

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
}

model Activity {
  id        String   @id @default(cuid())
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type      String
  summary   String
  detail    String?
  createdAt DateTime @default(now())
}

model Task {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  title       String
  dueDate     DateTime
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model MessageTemplate {
  id        String   @id @default(cuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Messenger {
  id        String   @id @default(cuid())
  name      String   // "واتساپ", "ایتا", etc.
  key       String   @unique // "WHATSAPP", "ETA", etc.
  linkTemplate String // "https://wa.me/{phone}?text={message}"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ListOption {
  id    String @id @default(cuid())
  type  String // "SOURCE" or "INDUSTRY"
  value String
}

model StagedLead {
  id             String   @id @default(cuid())
  
  businessName   String
  contactPerson  String?
  phoneNumber    String
  secondaryPhone String?
  industry       String
  source         String   // "بلد", "گوگل مپ", "نشان", "اتحادیه شیمیایی", ...
  category       String?
  address        String?
  website        String?
  rating         Float?
  notes          String?
  
  // اطلاعات اضافی برای ردیابی
  matchedKeyword String?
  searchedIndustry String?
  
  // وضعیت
  status         String   @default("PENDING") // PENDING, IMPORTED, IGNORED
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  importedAt     DateTime? // زمان تبدیل به Lead
  
  @@index([phoneNumber])
  @@index([status])
  @@index([source])
}

model AvvalSearchHistory {
  id              String   @id @default(cuid())
  slug            String
  industry        String
  count           Int      @default(0)
  pages           Int      @default(0)
  searchCount     Int      @default(1)
  lastSearchedAt  DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([slug, industry])
  @@index([lastSearchedAt])
}
